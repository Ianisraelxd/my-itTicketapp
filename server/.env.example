# Copy this file to server/.env only if you need to change something. Every value has a default.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=helpdesk
# DB_SSL=true            required by most cloud databases (TiDB Cloud, Aiven)
PORT=3001

# Sessions are signed with this secret. Leave it out to have one generated and saved for you.
# JWT_SECRET=change-me-to-a-long-random-text

# Auto-assign (minutes before an unresolved ticket moves to another agent; AUTO_ASSIGN=false turns it off)
# AUTO_ASSIGN_MINUTES=30
# AUTO_ASSIGN=false

# Priority escalation during finals week
# FINALS_WEEK=true

# Sign-in page, backups, auto-close
# AUTO_CLOSE_DAYS=3        resolved tickets close for good after this many days (0 = never)
# BACKUP_HOUR=2            daily backup runs at the first check after this hour (0-23)
# BACKUP_KEEP=14           how many daily backups to keep
# BACKUP=false             turn automatic backups off

# Alerts. Leave empty to keep emails off (in-app notifications always work).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=an-app-password
# MAIL_FROM="Campus HelpDesk <your-address@gmail.com>"
# APP_URL=https://help.yourcampus.edu
# MAIL_MODE=log            print emails in the server window instead of sending (testing)
# SMS_WEBHOOK_URL=         your SMS provider's URL: receives {to, message} for urgent alerts

# Going live: redirect http to https and send HSTS (needs a proxy that sets X-Forwarded-Proto)
# FORCE_HTTPS=true

# When hosted behind a proxy (Render, Railway, Nginx): the real visitor address for the rate limiter
# TRUST_PROXY=1

# First start only (empty database): who gets created.
# SEED_DEMO=false            create just one administrator instead of the eight demo accounts
# ADMIN_ID=SUP-0001
# ADMIN_NAME=System Administrator
# ADMIN_EMAIL=admin@campus.edu
# ADMIN_PASSWORD=            leave empty to get a random one printed once in the server log
# SEED_PASSWORD=             one fixed password for every seeded account (tests and demos only)
# SEED_MUST_CHANGE=false     do not force a password change at the first sign-in
